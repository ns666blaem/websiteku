import HomeHeader from '../components/HomeHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const head = "<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Nordy Sukmana — Performance Marketing Specialist Surabaya</title>\n<meta name=\"description\" content=\"Portfolio Nordy Sukmana, Performance Marketing Specialist di Surabaya. Berpengalaman mengelola Meta Ads, Google Ads, tracking, SEO, dan marketing automation.\">\n<meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n<meta name=\"theme-color\" content=\"#0C1F4D\">\n<link rel=\"canonical\" href=\"https://nordy-sukmana.vercel.app/\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"id_ID\">\n<meta property=\"og:locale:alternate\" content=\"en_US\">\n<meta property=\"og:site_name\" content=\"Portfolio Nordy Sukmana\">\n<meta property=\"og:title\" content=\"Nordy Sukmana — Performance Marketing Specialist Surabaya\">\n<meta property=\"og:description\" content=\"Portfolio, pengalaman, dan hasil kerja Nordy Sukmana dalam Meta Ads, Google Ads, tracking, SEO, dan marketing automation.\">\n<meta property=\"og:url\" content=\"https://nordy-sukmana.vercel.app/\">\n<meta property=\"og:image\" content=\"https://nordy-sukmana.vercel.app/assets/brand/open-graph.png\">\n<meta property=\"og:image:secure_url\" content=\"https://nordy-sukmana.vercel.app/assets/brand/open-graph.png\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta property=\"og:image:alt\" content=\"Nordy Sukmana, Performance Marketing Specialist — ROAS hingga 10x, 13 brand, dan pengalaman 4+ tahun.\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Nordy Sukmana — Performance Marketing Specialist Surabaya\">\n<meta name=\"twitter:description\" content=\"Portfolio, pengalaman, dan hasil kerja dalam Meta Ads, Google Ads, tracking, SEO, dan marketing automation.\">\n<meta name=\"twitter:image\" content=\"https://nordy-sukmana.vercel.app/assets/brand/open-graph.png\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"WebSite\",\n      \"@id\": \"https://nordy-sukmana.vercel.app/#website\",\n      \"url\": \"https://nordy-sukmana.vercel.app/\",\n      \"name\": \"Portfolio Nordy Sukmana\",\n      \"inLanguage\": \"id-ID\",\n      \"publisher\": {\n        \"@id\": \"https://nordy-sukmana.vercel.app/#person\"\n      }\n    },\n    {\n      \"@type\": \"ProfilePage\",\n      \"@id\": \"https://nordy-sukmana.vercel.app/#profile\",\n      \"url\": \"https://nordy-sukmana.vercel.app/\",\n      \"name\": \"Nordy Sukmana — Performance Marketing Specialist\",\n      \"isPartOf\": {\n        \"@id\": \"https://nordy-sukmana.vercel.app/#website\"\n      },\n      \"dateModified\": \"2026-09-17T11:58:28.588Z\",\n      \"mainEntity\": {\n        \"@id\": \"https://nordy-sukmana.vercel.app/#person\"\n      }\n    },\n    {\n      \"@type\": \"Person\",\n      \"@id\": \"https://nordy-sukmana.vercel.app/#person\",\n      \"name\": \"Nordy Sukmana\",\n      \"url\": \"https://nordy-sukmana.vercel.app/\",\n      \"image\": \"https://nordy-sukmana.vercel.app/assets/profile/nordy-sukmana-professional.webp\",\n      \"jobTitle\": \"Performance Marketing Specialist\",\n      \"description\": \"Performance Marketing Specialist berbasis di Surabaya dengan pengalaman mengelola Meta Ads, Google Ads, analytics, SEO, dan marketing automation.\",\n      \"homeLocation\": {\n        \"@type\": \"Place\",\n        \"name\": \"Surabaya, Jawa Timur, Indonesia\"\n      },\n      \"sameAs\": [\n        \"https://linkedin.com/in/ns666\"\n      ],\n      \"knowsAbout\": [\n        \"Meta Ads\",\n        \"Google Ads\",\n        \"Performance Marketing\",\n        \"Google Analytics 4\",\n        \"Google Tag Manager\",\n        \"Search Engine Optimization\",\n        \"Marketing Automation\"\n      ]\n    }\n  ]\n}\n</script>\n<link rel=\"icon\" href=\"assets/brand/nordy-mark.svg\" type=\"image/svg+xml\">\n<link rel=\"icon\" href=\"favicon.ico\" sizes=\"any\">\n<link rel=\"icon\" href=\"assets/brand/favicon-32.png\" type=\"image/png\" sizes=\"32x32\">\n<link rel=\"apple-touch-icon\" href=\"assets/brand/apple-touch-icon.png\" sizes=\"180x180\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap\" rel=\"stylesheet\">\r\n<link rel=\"stylesheet\" href=\"assets/main.css\">";
---
<BaseLayout head={head.replace('2026-08-15', '2026-09-06T10:00:00+07:00')}>
  <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
  <HomeHeader />
<main id="main-content" tabindex="-1">

  <!-- HERO -->
  <section class="hero">
    <span id="top" aria-hidden="true"></span>
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Performance Marketing Specialist · Surabaya</span>
        <h1>Nordy Sukmana<span class="role">Mengubah budget iklan jadi hasil yang terukur.</span></h1>
        <p class="hero-desc">Performance Marketing Specialist berbasis di Surabaya dengan pengalaman 4+ tahun mengelola Meta Ads, Google Ads, SEO, dan marketing automation. Fokus saya bukan sekadar traffic, tetapi tracking yang rapi, funnel yang sehat, dan keputusan campaign yang bisa dipertanggungjawabkan.</p>
        <div class="hero-cta">
          <a href="#results" class="btn-primary">Lihat Hasil Utama →</a>
          <a href="https://drive.google.com/file/d/1K3z3rdt-JiObACub4ywjAmBsKLSRiY_s/view?usp=sharing" class="btn-secondary" id="downloadCv" target="_blank" rel="noopener">Download CV</a>
        </div>
      </div>
      <aside class="performance-snapshot reveal" aria-labelledby="performance-snapshot-title">
        <h2 id="performance-snapshot-title" class="sr-only">Performance marketing snapshot Nordy Sukmana</h2>
        <div class="snapshot-grid">
          <section class="snapshot-card snapshot-card--roas" aria-labelledby="snapshot-roas-title">
            <div class="snapshot-card-head">
              <span class="snapshot-icon snapshot-icon--gold" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 18.5h16M5.5 16V8.5l4 4 4.2-7 4.8 3.2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><circle cx="5.5" cy="8.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="9.5" cy="12.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="13.7" cy="5.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="18.5" cy="8.7" r="1.3" fill="currentColor" stroke="none"/></svg>
              </span>
              <h3 id="snapshot-roas-title">Peak ROAS</h3>
            </div>
            <p class="snapshot-value">10<span>×</span></p>
            <p class="snapshot-caption">CPAS Shopee</p>
          </section>

          <section class="snapshot-card snapshot-card--brands" aria-labelledby="snapshot-brands-title">
            <div class="snapshot-card-head">
              <span class="snapshot-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M4.5 8.5h15v10h-15zM9 8.5V6.8c0-.7.6-1.3 1.3-1.3h3.4c.7 0 1.3.6 1.3 1.3v1.7M4.5 12.2c4.9 1.5 10.1 1.5 15 0M10.5 13.2h3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 id="snapshot-brands-title">Brands handled</h3>
            </div>
            <p class="snapshot-value">13</p>
            <p class="snapshot-caption">Across multiple industries</p>
          </section>

          <section class="snapshot-card snapshot-card--years" aria-labelledby="snapshot-years-title">
            <span class="snapshot-icon snapshot-icon--mint" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><rect x="4.5" y="6.5" width="15" height="13" rx="2" stroke="currentColor"/><path d="M8 4.5v4M16 4.5v4M4.5 10.5h15M8 14h3M8 17h6" stroke="currentColor" stroke-linecap="round"/></svg>
            </span>
            <div class="snapshot-years-copy">
              <h3 id="snapshot-years-title" class="sr-only">Performance marketing experience</h3>
              <strong>4+ years</strong>
              <span>Performance marketing</span>
            </div>
          </section>

          <section class="snapshot-card snapshot-card--rhythm" aria-labelledby="snapshot-rhythm-title">
            <div class="snapshot-card-head">
              <span class="snapshot-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M3.5 13h3l2-6 3.2 11 2.5-8 2.1 5H20.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <h3 id="snapshot-rhythm-title">Optimization rhythm</h3>
            </div>
            <div class="snapshot-bars" aria-hidden="true">
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
              <span class="snapshot-bar"></span>
            </div>
          </section>

          <section class="snapshot-card snapshot-card--channels" aria-labelledby="snapshot-channels-title">
            <h3 id="snapshot-channels-title" class="sr-only">Paid media channels</h3>
            <div class="snapshot-channel snapshot-channel--meta">
              <span class="snapshot-channel-mark" aria-hidden="true">
                <img src="assets/brand/meta-ads.svg" alt="" width="24" height="24">
              </span>
              Meta Ads
            </div>
            <div class="snapshot-channel snapshot-channel--google">
              <span class="snapshot-channel-mark" aria-hidden="true">
                <img src="assets/brand/google-ads.svg" alt="" width="24" height="24">
              </span>
              Google Ads
            </div>
            <div class="snapshot-channel snapshot-channel--tiktok">
              <span class="snapshot-channel-mark" aria-hidden="true">
                <img src="assets/brand/tiktok-ads.svg" alt="" width="26" height="26">
              </span>
              TikTok Ads
            </div>
          </section>
        </div>
      </aside>
    </div>
  </section>

  <!-- BRANDS -->
  <section id="brands" class="brands" aria-labelledby="brands-title">
    <div class="wrap brands-head reveal">
      <span class="eyebrow">Kolaborasi &amp; Pengalaman Brand</span>
      <h2 id="brands-title">Brand yang pernah ditangani.</h2>
      <p>Berpengalaman menangani campaign lintas industri dan objective.</p>
    </div>

    <div class="brand-marquee" role="group" aria-label="Daftar brand yang pernah ditangani">
      <div class="brand-track">
        <div class="brand-set">
          <div class="brand-card brand-card--square"><img class="brand-logo" src="assets/logos/prj.png" alt="PRJ" loading="lazy" decoding="async" width="150" height="151"></div>
          <div class="brand-card brand-card--unlabel"><img class="brand-logo" src="assets/logos/unlabel.png" alt="UNLABEL" loading="lazy" decoding="async" width="174" height="148"></div>
          <div class="brand-card brand-card--wide"><img class="brand-logo" src="assets/logos/beesafe.png" alt="Beesafe Integrated Security Solution" loading="lazy" decoding="async" width="349" height="128"></div>
          <div class="brand-card"><img class="brand-logo" src="assets/logos/insar-learning.png" alt="Insar Learning" loading="lazy" decoding="async" width="141" height="61"></div>
          <div class="brand-card brand-card--wide"><img class="brand-logo" src="assets/logos/surveiku.png" alt="SurveiKu" loading="lazy" decoding="async" width="736" height="252"></div>
          <div class="brand-card brand-card--ultrawide"><img class="brand-logo" src="assets/logos/sipendi.png" alt="SiPendi" loading="lazy" decoding="async" width="400" height="100"></div>
          <div class="brand-card brand-card--wide"><img class="brand-logo" src="assets/logos/kokek-consulting.png" alt="KOKEK Consulting" loading="lazy" decoding="async" width="379" height="129"></div>
          <div class="brand-card brand-card--dark brand-card--ultrawide"><img class="brand-logo" src="assets/logos/ekspectanica.png" alt="Ekspectanica" loading="lazy" decoding="async" width="350" height="48"></div>
          <div class="brand-card brand-card--ultrawide"><img class="brand-logo" src="assets/logos/historia.png" alt="Historia" loading="lazy" decoding="async" width="246" height="52"></div>
          <div class="brand-card brand-card--yellow"><img class="brand-logo" src="assets/logos/boboduck.png" alt="Boboduck" loading="lazy" decoding="async" width="148" height="29"></div>
          <div class="brand-card"><img class="brand-logo" src="assets/logos/tineco.png" alt="Tineco" loading="lazy" decoding="async" width="151" height="28"></div>
          <div class="brand-card"><img class="brand-logo" src="assets/logos/ecovacs.png" alt="Ecovacs" loading="lazy" decoding="async" width="146" height="43"></div>
          <div class="brand-card brand-card--square"><img class="brand-logo" src="assets/logos/koller-indonesia.png" alt="Koller Indonesia" loading="lazy" decoding="async" width="102" height="93"></div>
        </div>

        <div class="brand-set" aria-hidden="true">
          <div class="brand-card brand-card--square"><img class="brand-logo" src="assets/logos/prj.png" alt="" width="150" height="151"></div>
          <div class="brand-card brand-card--unlabel"><img class="brand-logo" src="assets/logos/unlabel.png" alt="" width="174" height="148"></div>
          <div class="brand-card brand-card--wide"><img class="brand-logo" src="assets/logos/beesafe.png" alt="" width="349" height="128"></div>
          <div class="brand-card"><img class="brand-logo" src="assets/logos/insar-learning.png" alt="" width="141" height="61"></div>
          <div class="brand-card brand-card--wide"><img class="brand-logo" src="assets/logos/surveiku.png" alt="" width="736" height="252"></div>
          <div class="brand-card brand-card--ultrawide"><img class="brand-logo" src="assets/logos/sipendi.png" alt="" width="400" height="100"></div>
          <div class="brand-card brand-card--wide"><img class="brand-logo" src="assets/logos/kokek-consulting.png" alt="" width="379" height="129"></div>
          <div class="brand-card brand-card--dark brand-card--ultrawide"><img class="brand-logo" src="assets/logos/ekspectanica.png" alt="" width="350" height="48"></div>
          <div class="brand-card brand-card--ultrawide"><img class="brand-logo" src="assets/logos/historia.png" alt="" width="246" height="52"></div>
          <div class="brand-card brand-card--yellow"><img class="brand-logo" src="assets/logos/boboduck.png" alt="" width="148" height="29"></div>
          <div class="brand-card"><img class="brand-logo" src="assets/logos/tineco.png" alt="" width="151" height="28"></div>
          <div class="brand-card"><img class="brand-logo" src="assets/logos/ecovacs.png" alt="" width="146" height="43"></div>
          <div class="brand-card brand-card--square"><img class="brand-logo" src="assets/logos/koller-indonesia.png" alt="" width="102" height="93"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- SELECTED RESULTS -->
  <section id="results" class="selected-results" aria-labelledby="results-title">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Selected Results</span>
        <h2 id="results-title">Bukti kerja, bukan sekadar klaim.</h2>
        <p>Tiga pekerjaan unggulan yang menunjukkan kemampuan saya membaca data, mengoptimasi campaign, dan menerjemahkan performa menjadi keputusan.</p>
      </div>

      <div class="results-grid">
        <a class="result-card result-card--featured reveal" href="case-study/shopee-cpas/" aria-label="Buka case study CPAS Shopee Super Shopping Day 9.9">
          <div class="result-media">
            <img src="assets/thumbnails/cpas-shopee.webp" alt="Cuplikan laporan CPAS Shopee Super Shopping Day 9.9" loading="lazy" decoding="async" width="1200" height="750">
          </div>
          <div class="result-body">
            <span class="result-feature-label">Featured · CPAS Meta Ads</span>
            <div class="result-top"><h3>CPAS Shopee — Super Shopping Day 9.9</h3><span class="result-arrow" aria-hidden="true">→</span></div>
            <p class="result-desc">Menjaga efisiensi purchase ketika reach, traffic, dan spend meningkat menjelang puncak campaign 9.9.</p>
            <div class="result-feature-outcome">
              <div class="result-impact-number">10×<small>ROAS</small></div>
              <div class="result-meta"><span>Case Study</span><span>Paid Social</span></div>
            </div>
          </div>
        </a>

        <a class="result-card reveal" href="case-study/meta-ads-unlabel/" aria-label="Buka case study Meta Ads Awareness UNLABEL">
          <div class="result-media">
            <img src="assets/thumbnails/meta-awareness-unlabel.webp" alt="Cuplikan dashboard Meta Ads Awareness UNLABEL dengan KPI, peta reach, dan analisis wilayah" loading="lazy" decoding="async" width="1200" height="750">
            <span class="result-kicker">Meta Ads · Awareness</span>
          </div>
          <div class="result-body">
            <div class="result-top"><h3>Meta Ads Awareness — UNLABEL</h3><span class="result-arrow" aria-hidden="true">→</span></div>
            <p class="result-desc">Analisis reach, impressions, biaya, wilayah, dan performa creative dalam dashboard interaktif.</p>
            <div class="result-meta"><span>Looker Studio</span><span>404K Reach</span></div>
          </div>
        </a>

        <a class="result-card reveal" href="case-study/performance-analysis/" aria-label="Buka Performance Ads Analysis">
          <div class="result-media">
            <img src="assets/thumbnails/performance-analysis-20260910.webp" alt="Ringkasan analisis terbaru Meta, Google, dan TikTok Ads dengan 4.285 order dan ROAS gabungan 8,7 kali" loading="lazy" decoding="async" width="1200" height="750">
            <span class="result-kicker">Cross-channel Analysis</span>
          </div>
          <div class="result-body">
            <div class="result-top"><h3>Performance Ads Analysis</h3><span class="result-arrow" aria-hidden="true">→</span></div>
            <p class="result-desc">Analisis 4.285 order, revenue Rp435,11 juta, ROAS, dan skenario budget Meta, Google, serta TikTok Ads.</p>
            <div class="result-meta"><span>Google Sheets</span><span>Meta · Google · TikTok</span></div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="wrap">
      <div class="about-grid">
        <div class="about-text reveal">
          <span class="eyebrow">Tentang Saya</span>
          <h2 class="about-title">Fokus pada angka, bukan sekadar impresi.</h2>
          <p>Saya Nordy, Digital Marketing Specialist asal Surabaya yang sudah 4+ tahun berkecimpung di dunia performance marketing — mulai dari agency consulting multi-brand, e-commerce, hingga sektor tech dan HORECA.</p>
          <p>Keahlian utama saya ada di Meta Ads dan Google Ads, didukung kemampuan teknis SEO, setup tracking (GA4, GTM, Meta CAPI), serta membangun dashboard pelaporan di Looker Studio supaya setiap keputusan campaign selalu berbasis data, bukan asumsi.</p>
          <p>Selain menjalankan iklan, saya juga terbiasa mengelola automation (Zapier, Make, CRM) untuk memastikan lead yang masuk benar-benar ditindaklanjuti — bukan cuma berhenti di angka klik.</p>
        </div>
        <aside class="about-aside reveal" aria-label="Profil singkat Nordy Sukmana">
          <div class="profile-card">
            <img class="profile-photo" src="assets/profile/nordy-sukmana-professional.webp" alt="Foto profesional Nordy Sukmana" loading="lazy" decoding="async" width="720" height="1015">
            <div class="profile-copy">
              <span class="profile-label">Profile</span>
              <strong>Nordy Sukmana</strong>
              <p>Performance Marketing Specialist</p>
              <span class="profile-stack">Meta Ads · Google Ads · Analytics</span>
            </div>
          </div>
          <div class="fact-list">
            <div class="fact"><span>Lokasi</span><span>Surabaya, Jawa Timur</span></div>
            <div class="fact"><span>Fokus</span><span>Meta Ads &amp; Google Ads</span></div>
            <div class="fact"><span>Pengalaman</span><span>4+ tahun</span></div>
            <div class="fact"><span>Sektor</span><span>Consulting, Tech, E-commerce, HORECA</span></div>
            <div class="fact"><span>Bahasa</span><span>Indonesia (Native), English</span></div>
            <div class="fact"><span>Status</span><span>Terbuka untuk peluang baru</span></div>
          </div>
        </aside>
      </div>

      <section class="profile-video reveal" aria-labelledby="profile-video-title">
        <button class="profile-video-media" type="button" data-video-open aria-haspopup="dialog" aria-controls="profile-video-modal" aria-label="Tonton video profil Nordy Sukmana di website">
          <img src="https://i.ytimg.com/vi/Nn3U1dr3FuY/maxresdefault.jpg" alt="Thumbnail video profil Nordy Sukmana" loading="lazy" decoding="async" width="1280" height="720">
          <span class="profile-video-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5z"></path></svg></span>
          <span class="profile-video-duration">1:18</span>
        </button>
        <div class="profile-video-copy">
          <span class="eyebrow">Video Profil</span>
          <h2 id="profile-video-title">Kenali saya dalam satu menit.</h2>
          <p>Ringkasan singkat tentang perjalanan profesional, pendekatan kerja, dan cara saya mengubah data marketing menjadi keputusan yang lebih terukur.</p>
          <div class="profile-video-actions">
            <button class="profile-video-cta profile-video-cta--primary" type="button" data-video-open aria-haspopup="dialog" aria-controls="profile-video-modal"><span class="profile-video-cta-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5z"></path></svg></span>Tonton di Website</button>
            <a class="profile-video-cta profile-video-cta--secondary" href="https://www.youtube.com/watch?v=Nn3U1dr3FuY" target="_blank" rel="noopener noreferrer">Buka di YouTube <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Pengalaman Kerja</span>
        <h2>Rekam jejak lintas industri.</h2>
        <p>Dari agency consulting multi-brand sampai in-house, dengan fokus konsisten pada performa campaign yang terukur.</p>
      </div>

      <div class="timeline">
        <div class="job reveal">
          <div class="job-top"><span class="job-role">Digital Marketing Specialist</span><span class="job-period">04/2026 — Present</span></div>
          <div class="job-company">PT Panen Rempah Jaya · Surabaya</div>
