---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyHeader from '../../components/CaseStudyHeader.astro';

const canonical = 'https://nordy-sukmana.vercel.app/negative-keyword-google-ads/';
const image = 'https://nordy-sukmana.vercel.app/assets/brand/open-graph.png';
const title = "Negative Keyword Google Ads: Cara Mengurangi Klik Tidak Relevan Tanpa Mematikan Volume";
const description = "Pelajari cara menggunakan negative keyword Google Ads untuk mengurangi klik tidak relevan, menjaga kualitas traffic, dan mengoptimalkan budget campaign.";
const faqItems = [
  {
    "question": "Berapa banyak negative keyword yang sebaiknya digunakan?",
    "answer": "Tidak ada jumlah ideal yang berlaku untuk semua campaign. Campaign sebaiknya memiliki negative keyword sebanyak yang dibutuhkan untuk mengontrol traffic yang memang tidak relevan. Daftar yang panjang tidak otomatis lebih baik. Yang lebih penting adalah kualitas dan relevansi setiap negative keyword."
  },
  {
    "question": "Apakah search term yang tidak menghasilkan conversion harus dijadikan negative keyword?",
    "answer": "Tidak selalu. Jika search term masih memiliki intent yang relevan, jangan langsung memblokirnya hanya karena belum menghasilkan conversion. Periksa jumlah klik, biaya, intent, dan volume data terlebih dahulu."
  },
  {
    "question": "Apa perbedaan negative keyword dengan keyword biasa?",
    "answer": "Keyword biasa membantu Google Ads memahami pencarian yang ingin ditargetkan. Negative keyword membantu advertiser menentukan pencarian yang tidak ingin ditargetkan. Keduanya digunakan bersama untuk mengontrol relevansi traffic."
  },
  {
    "question": "Apakah negative broad match aman digunakan?",
    "answer": "Negative broad match dapat berguna, tetapi perlu digunakan dengan hati-hati. Semakin umum istilah yang dimasukkan, semakin besar kemungkinan query yang sebenarnya relevan ikut terblokir. Gunakan analisis Search Terms Report sebelum membuat negative broad keyword yang luas."
  },
  {
    "question": "Seberapa sering Search Terms Report perlu diperiksa?",
    "answer": "Frekuensinya tergantung traffic dan budget campaign. Campaign dengan volume tinggi biasanya membutuhkan review lebih sering. Campaign dengan traffic lebih kecil dapat diperiksa dengan interval yang lebih panjang. Fokusnya bukan pada jadwal tertentu, tetapi memastikan search term baru tidak dibiarkan menghabiskan budget tanpa evaluasi."
  },
  {
    "question": "Apakah negative keyword bisa meningkatkan ROAS?",
    "answer": "Negative keyword dapat membantu meningkatkan efisiensi dengan mengurangi traffic yang tidak relevan. Namun ROAS juga dipengaruhi oleh banyak faktor seperti conversion rate, CPC, bidding, landing page, margin, product feed, tracking, dan conversion value. Karena itu, negative keyword sebaiknya dilihat sebagai bagian dari sistem optimasi campaign secara keseluruhan."
  }
];

