const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: 'Artikel Digital Marketing, SEO, Ads dan Analytics',
      description: 'Kumpulan artikel Nordy Sukmana tentang digital marketing, Meta Ads, Google Ads, TikTok Ads, LinkedIn Ads, SEO, analytics, AI Search, email marketing, dan automation.',
      inLanguage: 'id-ID',
      dateModified: '2026-10-18T10:00:00+07:00',
      mainEntity: {'@id': `${canonical}#article-list`}
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#article-list`,
      numberOfItems: articles.length,
      itemListElement: articles.map((article, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: article.title,
        url: `https://nordy-sukmana.vercel.app${article.href}`
      }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {'@type': 'ListItem', position: 1, name: 'Portfolio', item: 'https://nordy-sukmana.vercel.app/'},
        {'@type': 'ListItem', position: 2, name: 'Artikel', item: canonical}
      ]
    }
  ]
};

const head = `<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Artikel Digital Marketing, SEO, Ads dan Analytics | Nordy Sukmana</title>
<meta name="description" content="Kumpulan artikel Nordy Sukmana tentang digital marketing, Meta Ads, Google Ads, TikTok Ads, LinkedIn Ads, SEO, analytics, AI Search, email marketing, dan automation.">
<meta name="robots" content="index, follow, max-image-preview:large"><meta name="theme-color" content="#0C1F4D"><link rel="canonical" href="${canonical}">
<meta property="og:type" content="website"><meta property="og:locale" content="id_ID"><meta property="og:site_name" content="Portfolio Nordy Sukmana"><meta property="og:title" content="Artikel Digital Marketing, SEO, Ads dan Analytics"><meta property="og:description" content="Insight praktis tentang digital marketing, Google Ads, SEO, analytics, AI Search, email marketing, dan automation."><meta property="og:url" content="${canonical}"><meta property="og:image" content="https://nordy-sukmana.vercel.app/assets/brand/open-graph.png">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Artikel Digital Marketing, SEO, Ads dan Analytics"><meta name="twitter:description" content="Insight praktis tentang digital marketing, Google Ads, SEO, analytics, AI Search, email marketing, dan automation."><meta name="twitter:image" content="https://nordy-sukmana.vercel.app/assets/brand/open-graph.png">
<script type="application/ld+json">${JSON.stringify(structuredData)}</script>
<link rel="icon" href="../assets/brand/nordy-mark.svg" type="image/svg+xml"><link rel="icon" href="../favicon.ico" sizes="any"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="../assets/case-study.css"><link rel="stylesheet" href="../assets/articles-index.css?v=20260909-1">`;
---
<BaseLayout head={head} bodyClass="articles-page">
  <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
  <CaseStudyHeader />
  <main id="main-content">
    <header class="articles-hero">
      <div class="articles-shell">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="../">Portfolio</a><span aria-hidden="true">/</span><span>Artikel</span></nav>
        <span class="articles-kicker">Artikel dan Insight</span>
        <h1>Insight praktis untuk digital marketing yang lebih terukur.</h1>
        <p>Catatan, panduan, dan analisis dari pengalaman mengelola ads, tracking, SEO, analytics, serta marketing automation.</p>
      </div>
    </header>

    <section class="articles-browser articles-shell" aria-labelledby="articles-heading" data-articles-browser>
      <div class="articles-intro">
        <div><span class="articles-count">{articles.length} artikel</span><h2 id="articles-heading">Temukan topik yang ingin dipelajari</h2></div>
        <p>Gunakan pencarian atau pilih kategori untuk menyaring artikel.</p>
      </div>

      <div class="articles-controls">
        <label class="articles-search">
          <span>Cari artikel</span>
          <span class="articles-search-field"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.4-4.4m2.4-5.1a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"/></svg><input type="search" placeholder="Cari topik, misalnya Google Ads" autocomplete="off" data-article-search></span>
        </label>
        <div class="articles-category-filter">
          <span>Filter kategori</span>
          <div class="articles-filter-buttons" role="group" aria-label="Filter kategori artikel">
            <button type="button" data-article-filter="all" aria-pressed="true">Semua</button>
            <button type="button" data-article-filter="google-ads" aria-pressed="false">Google Ads</button>
            <button type="button" data-article-filter="paid-social" aria-pressed="false">Paid Social</button>
            <button type="button" data-article-filter="email-automation" aria-pressed="false">Email dan Automation</button>
            <button type="button" data-article-filter="analytics" aria-pressed="false">Analytics dan Tracking</button>
            <button type="button" data-article-filter="seo-ai" aria-pressed="false">SEO dan AI</button>
            <button type="button" data-article-filter="digital-marketing" aria-pressed="false">Digital Marketing</button>
          </div>
        </div>
      </div>

      <p class="articles-status" data-articles-status aria-live="polite">Menampilkan semua artikel</p>
      <div class="articles-grid" id="article-list">
        {articles.map(article => (
          <article class="article-card" data-article-card data-category={article.category} data-search={`${article.title} ${article.description} ${article.categoryLabel} ${article.topics.join(' ')}`.toLowerCase()}>
            <div class="article-card-top"><span class={`article-category article-category--${article.category}`}>{article.categoryLabel}</span><time datetime={article.isoDate}>{article.date}</time></div>
            <h3><a href={article.href}>{article.title}</a></h3>
            <p>{article.description}</p>
            <ul class="article-topics" aria-label="Topik artikel">{article.topics.map(topic => <li>{topic}</li>)}</ul>
            <div class="article-card-footer"><span>{article.readTime}</span><a href={article.href} aria-label={`Baca ${article.title}`}>Baca artikel <span aria-hidden="true">→</span></a></div>
          </article>
        ))}
      </div>
      <div class="articles-empty" data-articles-empty hidden><strong>Artikel belum ditemukan.</strong><p>Coba gunakan kata kunci atau kategori lain.</p></div>
    </section>
  </main>
  <footer class="articles-footer"><div class="articles-shell"><span>© 2026 Nordy Sukmana</span><div><a href="../#portfolio">Portfolio</a><a href="../#contact">Hubungi Saya</a></div></div></footer>
  <script is:inline src="/assets/articles-index.js?v=20260830-1"></script>
  <script is:inline src="/assets/analytics-loader.js"></script>
</BaseLayout>
