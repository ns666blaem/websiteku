---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyHeader from '../../../components/CaseStudyHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';

const head = "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>CPAS Shopee 9.9 Case Study — ROAS 10,49x | Nordy Sukmana</title>\n<meta name=\"description\" content=\"Case study CPAS Shopee Super Shopping Day 9.9: ROAS 10,49x, purchase value Rp85,75 juta, dan analisis efisiensi saat campaign di-scale.\">\n<meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n<meta name=\"theme-color\" content=\"#0C1F4D\">\n<link rel=\"canonical\" href=\"https://nordy-sukmana.vercel.app/case-study/shopee-cpas/\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:locale\" content=\"id_ID\">\n<meta property=\"og:locale:alternate\" content=\"en_US\">\n<meta property=\"og:site_name\" content=\"Portfolio Nordy Sukmana\">\n<meta property=\"og:title\" content=\"CPAS Shopee Super Shopping Day 9.9 — ROAS 10,49x\">\n<meta property=\"og:description\" content=\"Membaca performa harian CPAS Shopee untuk menjaga conversion value ketika budget dan traffic meningkat menjelang 9.9.\">\n<meta property=\"og:url\" content=\"https://nordy-sukmana.vercel.app/case-study/shopee-cpas/\">\n<meta property=\"og:image\" content=\"https://nordy-sukmana.vercel.app/assets/thumbnails/cpas-shopee.webp\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"CPAS Shopee Super Shopping Day 9.9 — ROAS 10,49x\">\n<meta name=\"twitter:description\" content=\"Case study CPAS Shopee dengan purchase value Rp85,75 juta dari spend Rp8,17 juta.\">\n<meta name=\"twitter:image\" content=\"https://nordy-sukmana.vercel.app/assets/thumbnails/cpas-shopee.webp\">\n<script type=\"application/ld+json\">\n{\n  \"@context\":\"https://schema.org\",\n  \"@type\":\"Article\",\n  \"headline\":\"CPAS Shopee Super Shopping Day 9.9: menjaga efisiensi hingga ROAS 10,49x\",\n  \"description\":\"Analisis performa harian CPAS Shopee Super Shopping Day 9.9 dari reach hingga purchase conversion value.\",\n  \"url\":\"https://nordy-sukmana.vercel.app/case-study/shopee-cpas/\",\n  \"image\":\"https://nordy-sukmana.vercel.app/assets/thumbnails/cpas-shopee.webp\",\n  \"inLanguage\":\"id-ID\",\n  \"dateModified\":\"2026-08-15\",\n  \"author\":{\"@type\":\"Person\",\"name\":\"Nordy Sukmana\",\"url\":\"https://nordy-sukmana.vercel.app/\"},\n  \"publisher\":{\"@type\":\"Person\",\"name\":\"Nordy Sukmana\",\"url\":\"https://nordy-sukmana.vercel.app/\"},\n  \"mainEntityOfPage\":\"https://nordy-sukmana.vercel.app/case-study/shopee-cpas/\"\n}\n</script>\n<link rel=\"icon\" href=\"../../assets/brand/nordy-mark.svg\" type=\"image/svg+xml\">\n<link rel=\"icon\" href=\"../../favicon.ico\" sizes=\"any\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"../../assets/case-study.css\">";
---
<BaseLayout head={head}>
  <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
  <CaseStudyHeader />
<main id="main-content">
  <section class="case-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="../../">Portfolio</a><span aria-hidden="true">/</span><span>CPAS Shopee 9.9</span></nav>
      <span class="case-badge">CPAS Meta Ads · Marketplace Conversion</span>
      <h1>CPAS Shopee Super Shopping Day 9.9: menjaga efisiensi hingga ROAS 10,49×.</h1>
      <p class="case-lede">Momentum 9.9 memberi peluang traffic yang besar, tetapi lonjakan reach tidak selalu diikuti kualitas pembelian yang sama. Saya membaca performa campaign ini secara harian untuk melihat kapan budget menghasilkan conversion value terbaik dan kapan scaling mulai menekan efisiensi.</p>
      <div class="meta-row"><span class="meta-chip">Shopee 9.9</span><span class="meta-chip">27 Agustus–11 September 2021</span><span class="meta-chip">Meta CPAS</span><span class="meta-chip">Daily performance analysis</span></div>
      <section class="metrics" aria-label="Ringkasan hasil campaign">
        <div class="metric"><span class="metric-label">Purchase ROAS</span><strong>10,49×</strong><small>Purchase value dibanding media spend</small></div>
        <div class="metric"><span class="metric-label">Purchase value</span><strong>Rp85,75 jt</strong><small>Dari 17 pembelian tercatat</small></div>
        <div class="metric"><span class="metric-label">Media spend</span><strong>Rp8,17 jt</strong><small>Selama 16 hari campaign</small></div>
        <div class="metric"><span class="metric-label">Reach</span><strong>304.910</strong><small>844.718 impressions · 3.456 klik</small></div>
      </section>
    </div>
  </section>

  <div class="shell content-wrap">
    <article class="article-card">
      <section class="story-section case-summary" aria-labelledby="case-summary-title">
        <span class="section-label">Ringkasan singkat</span>
        <h2 id="case-summary-title">Apa yang terjadi dan apa yang saya lakukan.</h2>
        <div class="case-summary-grid">
          <div class="case-summary-item"><h3>Masalah</h3><p>Traffic dan biaya iklan meningkat menjelang puncak 9.9, tetapi kualitas pembelian tidak selalu ikut naik.</p></div>
          <div class="case-summary-item"><h3>Keputusan saya</h3><p>Saya membaca performa setiap hari dan menjadikan nilai pembelian serta ROAS sebagai dasar untuk menilai kenaikan budget.</p></div>
          <div class="case-summary-item"><h3>Hasil</h3><p>Campaign menghasilkan nilai pembelian Rp85,75 juta dari biaya iklan Rp8,17 juta, dengan ROAS 10,49 kali.</p></div>
          <div class="case-summary-item"><h3>Bukti</h3><p>Laporan harian mencatat 17 pembelian, 202 add to cart, 3.456 klik, dan perubahan ROAS selama 16 hari campaign.</p></div>
          <div class="case-summary-item"><h3>Pelajaran</h3><p>Budget yang lebih besar tidak selalu memberi hasil yang lebih baik. Scaling perlu dilakukan bertahap dan mengikuti kualitas penjualan.</p></div>
        </div>
      </section>

      <section class="story-section">
        <span class="section-label">01 · Konteks</span>
        <h2>Memanfaatkan momentum 9.9 tanpa kehilangan kontrol atas efisiensi.</h2>
        <p class="lead-paragraph">Campaign Shopee Super Shopping Day 9.9 dijalankan melalui CPAS, yang menghubungkan iklan Meta dengan aktivitas produk di marketplace. Objective-nya bukan hanya mendatangkan traffic, tetapi mendorong pembelian yang dapat ditelusuri kembali ke budget iklan.</p>
        <p>Selama 27 Agustus sampai 11 September 2021, campaign menjangkau 304.910 orang dan menghasilkan 844.718 impressions. Dari spend Rp8.170.966, tercatat purchase conversion value Rp85.752.000 atau purchase ROAS 10,49×.</p>
        <figure class="evidence evidence--wide">
          <div class="report-scroll" tabindex="0" aria-label="Laporan CPAS Shopee dapat digeser secara horizontal">
            <img src="../../assets/case-studies/cpas-shopee-99-report.webp" alt="Laporan harian CPAS Shopee Super Shopping Day 9.9 yang menampilkan reach, impressions, spend, clicks, add to cart, purchases, conversion value, dan ROAS" width="1800" height="316">
          </div>
          <figcaption>Laporan lengkap campaign 27 Agustus–11 September 2021. Geser secara horizontal untuk membaca seluruh kolom.</figcaption>
        </figure>
      </section>

      <section class="story-section">
        <span class="section-label">02 · Tantangan</span>
        <h2>Traffic meningkat tajam menjelang puncak, tetapi kualitasnya tidak tumbuh dengan kecepatan yang sama.</h2>
        <p>Pada 9–11 September, reach, impressions, klik, dan spend mencapai level tertinggi. Namun, daily purchase ROAS turun dari 11,76× pada 9 September menjadi 6,25× pada 10 September dan 0,35× pada 11 September.</p>
        <p>Pola ini membuat saya tidak cukup hanya melihat total ROAS. Campaign memang menghasilkan return yang kuat secara keseluruhan, tetapi data harian menunjukkan bahwa penambahan budget pada fase puncak perlu dikendalikan agar tidak membeli volume yang semakin mahal dengan kualitas konversi yang menurun.</p>
        <div class="insight-box"><strong>Scaling bukan sekadar menaikkan spend.</strong><p>Budget tambahan baru menciptakan pertumbuhan yang sehat jika purchase conversion value ikut bertambah dengan rasio yang masih dapat diterima.</p></div>
      </section>

      <section class="story-section">
        <span class="section-label">03 · Pendekatan</span>
        <h2>Saya memisahkan volume, intent, dan nilai transaksi.</h2>
        <ol class="process-list">
          <li><strong>Volume distribusi</strong>Reach dan impressions digunakan untuk melihat seberapa besar momentum 9.9 memperluas exposure campaign.</li>
          <li><strong>Kualitas traffic</strong>Unique link clicks dibandingkan dengan spend dan perubahan harian agar lonjakan traffic tidak otomatis dianggap sebagai perbaikan.</li>
          <li><strong>Sinyal intent</strong>Jumlah add to cart dibaca sebagai minat kuat, tetapi tetap dipisahkan dari purchase karena keduanya memiliki nilai bisnis yang berbeda.</li>
          <li><strong>Hasil akhir</strong>Purchase conversion value dan purchase ROAS menjadi dasar utama untuk menilai apakah budget benar-benar menghasilkan penjualan.</li>
        </ol>
      </section>

      <section class="story-section">
        <span class="section-label">04 · Temuan</span>
        <h2>Hasil akhirnya kuat, sementara data harian menunjukkan ruang optimasi yang jelas.</h2>
        <ul class="finding-list">
          <li><strong>Campaign membukukan ROAS 10,49×.</strong>Purchase conversion value Rp85,75 juta dihasilkan dari spend Rp8,17 juta.</li>
          <li><strong>Hari paling efisien tidak membutuhkan spend tertinggi.</strong>ROAS harian tertinggi tercatat 39,28× pada 2 September dan 31,87× pada 3 September, ketika spend masih berada di kisaran Rp350 ribu per hari.</li>
          <li><strong>Puncak traffic menekan efisiensi.</strong>Pada 10 dan 11 September, spend mencapai sekitar Rp1,37 juta per hari, tetapi purchase ROAS turun menjadi 6,25× dan 0,35×.</li>
          <li><strong>Masih ada jarak besar dari cart ke purchase.</strong>Campaign menghasilkan 202 add to cart dan 17 purchase; sekitar 8,4% sinyal cart berlanjut menjadi transaksi tercatat.</li>
          <li><strong>Add-to-cart value tidak boleh disamakan dengan revenue.</strong>Nilai keranjang mencapai Rp1,40 miliar, tetapi keputusan akhir tetap didasarkan pada purchase conversion value Rp85,75 juta.</li>
        </ul>
      </section>

      <section class="story-section">
        <span class="section-label">05 · Rekomendasi</span>
        <h2>Mempertahankan hasil 10× dengan scaling yang lebih selektif.</h2>
        <ul class="recommend-list">
          <li><strong>Gunakan purchase ROAS sebagai guardrail scaling.</strong>Budget dapat dinaikkan bertahap selama conversion value tumbuh dan daily ROAS tidak turun melewati batas yang disepakati.</li>
          <li><strong>Majukan sebagian budget ke fase pra-puncak.</strong>Data 2–5 September menunjukkan efisiensi tinggi sebelum lonjakan spend pada tiga hari terakhir.</li>
          <li><strong>Bangun retargeting untuk cart abandoner.</strong>Audiens yang sudah menambahkan produk ke keranjang membutuhkan pesan promo, urgency, dan benefit checkout yang lebih spesifik.</li>
          <li><strong>Refresh creative menjelang peak day.</strong>Peningkatan volume dapat mempercepat fatigue; variasi pesan dan visual perlu disiapkan sebelum frekuensi serta kompetisi naik.</li>
          <li><strong>Pisahkan monitoring cart value dan purchase value.</strong>Keduanya berguna, tetapi hanya purchase value yang digunakan untuk mengukur revenue campaign.</li>
        </ul>
        <div class="insight-box"><strong>Pelajaran utama</strong><p>ROAS 10,49× adalah hasil yang kuat. Nilai tambah analisisnya terletak pada kemampuan melihat kapan performa tersebut terbentuk dan bagaimana menjaganya saat campaign memasuki fase scaling.</p></div>
      </section>
    </article>

    <aside class="side-column" aria-label="Ringkasan case study">
      <section class="side-card"><h2>Peran saya</h2><ul><li><span>Monitoring</span><strong>Daily performance</strong></li><li><span>Funnel</span><strong>Click → Purchase</strong></li><li><span>Output</span><strong>Scaling insight</strong></li></ul></section>
      <section class="side-card"><h2>Stack</h2><ul><li><span>Media</span><strong>Meta CPAS</strong></li><li><span>Commerce</span><strong>Shopee</strong></li><li><span>Reporting</span><strong>Daily report</strong></li></ul></section>
      <section class="side-card source-note"><span class="source-kicker">Catatan data</span><p>ROAS 10,49× berasal dari purchase conversion value Rp85.752.000 dibagi spend Rp8.170.966. Analisis harian digunakan untuk menunjukkan perubahan efisiensi selama periode campaign.</p></section>
    </aside>
  </div>

  <section class="next-section">
    <div class="shell">
      <div class="next-head"><h2>Lanjut ke case study berikutnya.</h2><a href="../../#portfolio">Lihat seluruh portfolio →</a></div>
      <div class="next-grid">
        <a class="next-card" href="../meta-ads-unlabel/"><span>Meta Ads · Awareness</span><h3>UNLABEL creative A/B test</h3><p>Memilih creative yang lebih efisien dengan membandingkan reach, impressions, CPM, dan CPR.</p></a>
        <a class="next-card" href="../performance-analysis/"><span>Cross-channel</span><h3>Performance Ads Analysis</h3><p>Menyusun prioritas budget Meta, Google, dan TikTok Ads berdasarkan efisiensi channel.</p></a>
      </div>
    </div>
  </section>
</main>
  <SiteFooter caseStudy />
  <script is:inline src="/assets/analytics-loader.js"></script>
</BaseLayout>
