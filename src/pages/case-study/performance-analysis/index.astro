import CaseStudyHeader from '../../../components/CaseStudyHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';

const head = "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Analisis Performa Iklan Lintas Channel | Nordy Sukmana</title>\n<meta name=\"description\" content=\"Analisis Meta, Google, dan TikTok Ads dengan 4.285 order, revenue Rp435.106.000, ROAS 8,7 kali, dan skenario alokasi budget.\">\n<meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n<meta name=\"theme-color\" content=\"#0C1F4D\">\n<link rel=\"canonical\" href=\"https://nordy-sukmana.vercel.app/case-study/performance-analysis/\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:locale\" content=\"id_ID\">\n<meta property=\"og:locale:alternate\" content=\"en_US\">\n<meta property=\"og:site_name\" content=\"Portfolio Nordy Sukmana\">\n<meta property=\"og:title\" content=\"Analisis Performa Iklan Lintas Channel\">\n<meta property=\"og:description\" content=\"Analisis Meta, Google, dan TikTok Ads dengan 4.285 order, revenue Rp435.106.000, ROAS 8,7 kali, dan skenario alokasi budget.\">\n<meta property=\"og:url\" content=\"https://nordy-sukmana.vercel.app/case-study/performance-analysis/\">\n<meta property=\"og:image\" content=\"https://nordy-sukmana.vercel.app/assets/thumbnails/performance-analysis-20260910.webp\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Analisis Performa Iklan Lintas Channel\">\n<meta name=\"twitter:description\" content=\"Analisis Meta, Google, dan TikTok Ads dengan 4.285 order, revenue Rp435.106.000, ROAS 8,7 kali, dan skenario alokasi budget.\">\n<meta name=\"twitter:image\" content=\"https://nordy-sukmana.vercel.app/assets/thumbnails/performance-analysis-20260910.webp\">\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"Article\",\n  \"headline\": \"Analisis Meta, Google, dan TikTok Ads untuk menentukan prioritas budget\",\n  \"description\": \"Analisis Meta, Google, dan TikTok Ads dengan 4.285 order, revenue Rp435.106.000, ROAS 8,7 kali, dan skenario alokasi budget.\",\n  \"url\": \"https://nordy-sukmana.vercel.app/case-study/performance-analysis/\",\n  \"image\": \"https://nordy-sukmana.vercel.app/assets/thumbnails/performance-analysis-20260910.webp\",\n  \"inLanguage\": \"id-ID\",\n  \"dateModified\": \"2026-09-10T10:28:58.947Z\",\n  \"author\": {\n    \"@type\": \"Person\",\n    \"name\": \"Nordy Sukmana\",\n    \"url\": \"https://nordy-sukmana.vercel.app/\"\n  },\n  \"publisher\": {\n    \"@type\": \"Person\",\n    \"name\": \"Nordy Sukmana\",\n    \"url\": \"https://nordy-sukmana.vercel.app/\"\n  },\n  \"mainEntityOfPage\": \"https://nordy-sukmana.vercel.app/case-study/performance-analysis/\",\n  \"citation\": \"https://docs.google.com/spreadsheets/d/1RdYfoz-1NykvXXloXpQLg55o16j6561xREssq1MPY24/edit?gid=0#gid=0\"\n}\n</script>\n<link rel=\"icon\" href=\"../../assets/brand/nordy-mark.svg\" type=\"image/svg+xml\">\n<link rel=\"icon\" href=\"../../favicon.ico\" sizes=\"any\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"../../assets/case-study.css\">\n<link rel=\"stylesheet\" href=\"../../assets/performance-analysis.css?v=20260910\">";
---
<BaseLayout head={head}>
  <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
  <CaseStudyHeader />
<main id="main-content">
  <section class="case-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="../../">Portfolio</a><span aria-hidden="true">/</span><span>Performance Analysis</span></nav>
      <span class="case-badge">Meta · Google · TikTok Ads</span>
      <h1>Analisis Meta, Google, dan TikTok Ads untuk menentukan prioritas budget.</h1>
      <p class="case-lede">Dari biaya iklan Rp50.000.000, dataset mencatat 4.285 order dan revenue Rp435.106.000. Saya membandingkan biaya per order, biaya memperoleh pelanggan, AOV, dan ROAS untuk menentukan channel yang layak mendapat tambahan budget.</p>
      <div class="meta-row"><span class="meta-chip">Studi analisis dataset</span><span class="meta-chip">3.088 Customer Acquired</span><span class="meta-chip">295.912 klik</span><span class="meta-chip">Diperbarui <time datetime="2026-09-10">10 September 2026</time></span></div>
      <section class="metrics" aria-label="Ringkasan dataset terbaru">
        <div class="metric"><span class="metric-label">Biaya iklan</span><strong>Rp50 jt</strong><small>Meta 50% · Google 30% · TikTok 20%</small></div>
        <div class="metric"><span class="metric-label">Order</span><strong>4.285</strong><small>Biaya per order Rp11.669</small></div>
        <div class="metric"><span class="metric-label">Revenue</span><strong>Rp435,11 jt</strong><small>Jumlah revenue ketiga channel</small></div>
        <div class="metric"><span class="metric-label">ROAS gabungan</span><strong>8,7×</strong><small>Total revenue dibagi biaya iklan</small></div>
      </section>
    </div>
  </section>

  <div class="shell content-wrap">
    <article class="article-card">
      <section class="story-section case-summary" aria-labelledby="case-summary-title">
        <span class="section-label">Ringkasan singkat</span>
        <h2 id="case-summary-title">Menilai hasil dari biaya yang dikeluarkan.</h2>
        <div class="case-summary-grid">
          <div class="case-summary-item"><h3>Masalah</h3><p>Meta memakai 50% budget, tetapi menyumbang 28,3% order. Besarnya alokasi perlu ditinjau bersama nilai penjualan dan biaya memperoleh pelanggan.</p></div>
          <div class="case-summary-item"><h3>Analisis saya</h3><p>Saya memisahkan jumlah order, pelanggan, nilai rata rata order, dan total revenue agar perbandingan ketiga channel memakai ukuran yang jelas.</p></div>
          <div class="case-summary-item"><h3>Temuan</h3><p>Google menghasilkan revenue tertinggi, Rp183.078.000. TikTok menghasilkan order terbanyak dan ROAS tertinggi, 12,5×.</p></div>
          <div class="case-summary-item"><h3>Arah budget</h3><p>Skenario pada Sheet mengubah alokasi menjadi Meta 20%, Google 30%, dan TikTok 50%. Pergeseran ini perlu diuji bertahap untuk melihat respons biaya dan revenue.</p></div>
          <div class="case-summary-item"><h3>Pelajaran</h3><p>ROAS membantu membandingkan hasil dari biaya iklan. Keputusan penambahan budget tetap perlu mempertimbangkan AOV, margin, dan kemampuan channel mempertahankan efisiensinya.</p></div>
        </div>
      </section>

      <section class="story-section" id="data-dan-konteks">
        <span class="section-label">01 · Data dan konteks</span>
        <h2>Membaca ulang dataset dengan angka terbaru.</h2>
        <p class="lead-paragraph">Analisis ini memakai tabel pada tab “1. Analisa Campaign” di Google Sheets yang dibaca pada 10 September 2026. Tiga channel menggunakan total budget Rp50.000.000, menghasilkan 14.131.428 impressions, 295.912 klik, dan 4.285 order.</p>
        <p>Kolom Customer Acquired berjumlah 3.088 ketika ketiga channel dijumlahkan. Untuk memastikan jumlah pelanggan unik lintas channel, data ini masih perlu dicocokkan dengan ID pelanggan. Dataset juga belum memuat periode campaign yang spesifik, sehingga tanggal pembaruan halaman menunjukkan waktu pembacaan data.</p>
        <figure class="evidence">
          <a class="performance-image-link" href="../../assets/thumbnails/performance-analysis-20260910.webp" target="_blank" rel="noopener" aria-label="Buka gambar ringkasan performa dalam ukuran penuh">
            <img src="../../assets/thumbnails/performance-analysis-20260910.webp" alt="Ringkasan terbaru: 4.285 order, revenue Rp435.106.000 dan ROAS gabungan 8,7 kali. Tabel memperlihatkan hasil Meta, Google, dan TikTok Ads serta perbandingan porsi budget dengan order." width="1200" height="750" decoding="async">
          </a>
          <figcaption>Visual ringkasan dari tabel terbaru pada Google Sheets. Klik gambar untuk memperbesar. Angka lengkap tersedia pada tabel perbandingan di bawah.</figcaption>
        </figure>
        <p class="performance-source"><a href="https://docs.google.com/spreadsheets/d/1RdYfoz-1NykvXXloXpQLg55o16j6561xREssq1MPY24/edit?gid=0#gid=0" target="_blank" rel="noopener">Lihat data sumber di Google Sheets ↗</a></p>
      </section>

      <section class="story-section" id="cara-membaca-metrik">
        <span class="section-label">02 · Metode</span>
        <h2>Order, pelanggan, dan revenue memiliki perhitungan berbeda.</h2>
        <ol class="process-list">
          <li><strong>Biaya memperoleh traffic</strong>CPC dihitung dari biaya iklan dibagi klik. CTR dihitung dari klik dibagi impressions. Angka gabungan memakai total pembilang dan penyebut dari ketiga channel.</li>
          <li><strong>Biaya per order</strong>Biaya iklan dibagi jumlah order, disebut Cost per Sales pada Sheet. Contohnya, Meta membelanjakan Rp25.000.000 untuk 1.213 order, sehingga biayanya sekitar Rp20.610 per order.</li>
          <li><strong>Biaya iklan per pelanggan</strong>Biaya iklan dibagi Customer Acquired, diberi nama CAC pada Sheet. Meta mencatat 809 pelanggan, sehingga nilainya sekitar Rp30.902. Cakupan biaya dalam perhitungan ini adalah biaya iklan.</li>
          <li><strong>Revenue dan ROAS</strong>Revenue dihitung dari order × AOV, kemudian dibagi biaya iklan untuk memperoleh ROAS. AOV sudah mewakili nilai per order. Contoh Google, 1.453 × Rp126.000 menghasilkan revenue Rp183.078.000 dan ROAS 12,2×.</li>
        </ol>
        <p class="performance-note">AOV menunjukkan nilai rata rata satu order. Revenue menunjukkan nilai penjualan keseluruhan. ROAS membandingkan revenue dengan biaya iklan dan perlu dilengkapi data margin untuk menilai profitabilitas.</p>
      </section>

      <section class="story-section" id="perbandingan-channel">
        <span class="section-label">03 · Perbandingan</span>
        <h2>Google memimpin revenue, TikTok paling efisien pada biaya order.</h2>
        <div class="performance-table-wrap" role="region" aria-label="Perbandingan performa tiga channel, geser untuk melihat semua kolom" tabindex="0">
          <table class="performance-table"><caption>Performa berdasarkan tabel Google Sheets terbaru</caption><thead><tr><th scope="col">Metrik</th><th scope="col">Meta Ads</th><th scope="col">Google Ads</th><th scope="col">TikTok Ads</th></tr></thead><tbody><tr><th scope="row">Biaya iklan</th><td>Rp25.000.000</td><td>Rp15.000.000</td><td>Rp10.000.000</td></tr>
<tr><th scope="row">Impressions</th><td>4.204.838</td><td>4.079.950</td><td>5.846.640</td></tr>
<tr><th scope="row">Klik</th><td>105.121</td><td>126.478</td><td>64.313</td></tr>
<tr><th scope="row">Order</th><td>1.213</td><td>1.453</td><td>1.619</td></tr>
<tr><th scope="row">Customer Acquired</th><td>809</td><td>807</td><td>1.472</td></tr>
<tr><th scope="row">CPC</th><td>Rp238</td><td>Rp119</td><td>Rp155</td></tr>
<tr><th scope="row">CTR</th><td>2,5%</td><td>3,1%</td><td>1,1%</td></tr>
<tr><th scope="row">Biaya per order</th><td>Rp20.610</td><td>Rp10.323</td><td>Rp6.177</td></tr>
<tr><th scope="row">Biaya iklan per pelanggan</th><td>Rp30.902</td><td>Rp18.587</td><td>Rp6.793</td></tr>
<tr><th scope="row">AOV</th><td>Rp105.000</td><td>Rp126.000</td><td>Rp77.000</td></tr>
<tr><th scope="row">Revenue</th><td>Rp127.365.000</td><td>Rp183.078.000</td><td>Rp124.663.000</td></tr>
<tr><th scope="row">ROAS</th><td>5,1×</td><td>12,2×</td><td>12,5×</td></tr></tbody></table>
        </div>
        <p class="performance-note">Nilai rupiah dibulatkan ke satuan terdekat, CTR dan ROAS ditampilkan dengan satu angka desimal. Biaya iklan per pelanggan mengikuti metrik CAC pada Sheet.</p>
        <ul class="finding-list">
          <li><strong>Google menghasilkan nilai penjualan terbesar.</strong>Revenue Rp183.078.000 menyumbang 42,1% dari total. AOV Rp126.000 juga tertinggi, didukung CPC Rp119 dan CTR 3,1%.</li>
          <li><strong>TikTok menghasilkan order paling banyak dengan biaya paling rendah.</strong>Alokasi 20% budget menghasilkan 1.619 order, atau 37,8% dari total. Biaya per order Rp6.177, biaya iklan per pelanggan Rp6.793, dan ROAS 12,5× mendukung pengujian tambahan budget.</li>
          <li><strong>Meta membutuhkan evaluasi efisiensi.</strong>Budget Rp25.000.000 menghasilkan 1.213 order dan revenue Rp127.365.000. ROAS 5,1× serta biaya iklan per pelanggan Rp30.902 menunjukkan jarak efisiensi terhadap dua channel lain dalam dataset ini.</li>
          <li><strong>AOV TikTok menjadi ruang optimasi berikutnya.</strong>AOV Rp77.000 merupakan yang terendah. Uji bundling atau penawaran tambahan dapat membantu meningkatkan nilai order sambil memantau margin dan biaya konversi.</li>
        </ul>
      </section>

      <section class="story-section" id="skenario-budget">
        <span class="section-label">04 · Skenario budget</span>
        <h2>Menguji alokasi baru dengan asumsi yang jelas.</h2>
        <p>Sheet mengusulkan perubahan alokasi menjadi Meta 20%, Google 30%, dan TikTok 50%, dengan total biaya tetap Rp50.000.000. Sebagai ilustrasi, saya menghitung ulang potensi revenue menggunakan ROAS setiap channel dari tabel, sebelum pembulatan.</p>
        <div class="performance-table-wrap" role="region" aria-label="Ilustrasi alokasi budget dan revenue, geser untuk melihat semua kolom" tabindex="0">
          <table class="performance-table"><caption>Ilustrasi jika ROAS setiap channel tetap</caption><thead><tr><th scope="col">Channel</th><th scope="col">Budget awal</th><th scope="col">Budget uji</th><th scope="col">Revenue ilustrasi</th></tr></thead><tbody>
          <tr><th scope="row">Meta Ads</th><td>Rp25.000.000</td><td>Rp10.000.000</td><td>Rp50.946.000</td></tr>
<tr><th scope="row">Google Ads</th><td>Rp15.000.000</td><td>Rp15.000.000</td><td>Rp183.078.000</td></tr>
<tr><th scope="row">TikTok Ads</th><td>Rp10.000.000</td><td>Rp25.000.000</td><td>Rp311.657.500</td></tr>
          </tbody><tfoot><tr><th scope="row">Total</th><td>Rp50.000.000</td><td>Rp50.000.000</td><td>Rp545.681.500</td></tr></tfoot></table>
        </div>
        <div class="insight-box"><strong>Ilustrasi pertumbuhan revenue sekitar 25,4%.</strong><p>Dengan asumsi ROAS tetap, revenue berubah dari Rp435.106.000 menjadi Rp545.681.500. Target tiga kali lipat yang disebut pada Sheet masih perlu didukung perubahan performa tambahan dan hasil pengujian. Angka ilustrasi ini memakai hubungan biaya dan revenue yang konstan, sementara efisiensi dapat berubah ketika budget dinaikkan.</p></div>
      </section>

      <section class="story-section" id="rekomendasi">
        <span class="section-label">05 · Rekomendasi</span>
        <h2>Perubahan budget diikuti evaluasi hasil.</h2>
        <ul class="recommend-list">
          <li><strong>Uji kenaikan budget TikTok secara bertahap.</strong>Pantau biaya per order, biaya iklan per pelanggan, AOV, dan ROAS pada setiap tahap. Perbesar alokasi ketika penambahan biaya tetap menghasilkan penjualan yang sesuai target.</li>
          <li><strong>Pertahankan kontribusi Google pada revenue.</strong>Alokasi 30% menjadi titik awal pengujian karena Google menghasilkan revenue dan AOV tertinggi dalam dataset. Evaluasi kembali porsinya berdasarkan hasil setelah perubahan budget.</li>
          <li><strong>Perbaiki efisiensi Meta.</strong>Periksa audience, creative, objective, dan kontribusi assisted conversion. Gunakan temuan tersebut untuk menentukan perbaikan campaign sebelum kembali menambah budget.</li>
          <li><strong>Hubungkan laporan dengan data bisnis.</strong>Cocokkan order, pelanggan, pembatalan, dan revenue dengan catatan transaksi. Sertakan margin serta biaya lain untuk menilai hasil bisnis setelah belanja iklan.</li>
        </ul>
      </section>
    </article>

    <aside class="side-column" aria-label="Ringkasan case study">
      <section class="side-card"><h2>Peran saya</h2><ul><li><span>Data</span><strong>Perhitungan metrik</strong></li><li><span>Analisis</span><strong>Perbandingan channel</strong></li><li><span>Output</span><strong>Skenario budget</strong></li></ul></section>
      <section class="side-card"><h2>Ringkasan</h2><ul><li><span>Channel</span><strong>3 platform</strong></li><li><span>Customer Acquired</span><strong>3.088</strong></li><li><span>ROAS gabungan</span><strong>8,7×</strong></li><li><span>Pembaruan</span><strong>10 Sep 2026</strong></li></ul><a class="performance-source-link" href="https://docs.google.com/spreadsheets/d/1RdYfoz-1NykvXXloXpQLg55o16j6561xREssq1MPY24/edit?gid=0#gid=0" target="_blank" rel="noopener">Buka Google Sheets ↗</a></section>
      <section class="side-card source-note"><span class="source-kicker">Status analisis</span><p>Studi ini memakai dataset pada Google Sheets. Skenario budget adalah usulan pengujian. Hasil setelah perubahan alokasi belum tersedia dalam dataset.</p></section>
    </aside>
  </div>

  <section class="next-section">
    <div class="shell">
      <div class="next-head"><h2>Lanjut ke case study berikutnya.</h2><a href="../../#portfolio">Lihat seluruh portfolio →</a></div>
      <div class="next-grid">
        <a class="next-card" href="../shopee-cpas/"><span>CPAS · Marketplace</span><h3>Shopee Super Shopping Day 9.9</h3><p>ROAS 10,49× dengan analisis efisiensi harian saat traffic dan budget meningkat.</p></a>
        <a class="next-card" href="../meta-ads-unlabel/"><span>Meta Ads · Awareness</span><h3>UNLABEL creative A/B test</h3><p>Memilih creative yang lebih efisien dengan membandingkan reach, impressions, CPM, dan CPR.</p></a>
      </div>
    </div>
  </section>
</main>
  <SiteFooter caseStudy />
  <script is:inline src="/assets/analytics-loader.js"></script>
</BaseLayout>
