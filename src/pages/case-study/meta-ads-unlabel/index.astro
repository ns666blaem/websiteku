---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudyHeader from '../../../components/CaseStudyHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';

const head = "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Meta Ads Awareness UNLABEL Case Study | Nordy Sukmana</title>\n<meta name=\"description\" content=\"Case study Meta Ads Awareness UNLABEL: reach 404 ribu dengan biaya Rp599 ribu dan pemilihan creative melalui A/B testing berbasis CPM dan CPR.\">\n<meta name=\"robots\" content=\"index, follow, max-image-preview:large\">\n<meta name=\"theme-color\" content=\"#0C1F4D\">\n<link rel=\"canonical\" href=\"https://nordy-sukmana.vercel.app/case-study/meta-ads-unlabel/\">\n<meta property=\"og:type\" content=\"article\">\n<meta property=\"og:locale\" content=\"id_ID\">\n<meta property=\"og:locale:alternate\" content=\"en_US\">\n<meta property=\"og:site_name\" content=\"Portfolio Nordy Sukmana\">\n<meta property=\"og:title\" content=\"Meta Ads Awareness UNLABEL — Creative A/B Test\">\n<meta property=\"og:description\" content=\"Menentukan creative awareness yang lebih efisien dengan membaca reach, impressions, CPM, CPR, dan wilayah.\">\n<meta property=\"og:url\" content=\"https://nordy-sukmana.vercel.app/case-study/meta-ads-unlabel/\">\n<meta property=\"og:image\" content=\"https://nordy-sukmana.vercel.app/assets/thumbnails/meta-awareness-unlabel.webp\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Meta Ads Awareness UNLABEL — Creative A/B Test\">\n<meta name=\"twitter:description\" content=\"Reach 404 ribu dengan analisis creative dan efisiensi biaya awareness.\">\n<meta name=\"twitter:image\" content=\"https://nordy-sukmana.vercel.app/assets/thumbnails/meta-awareness-unlabel.webp\">\n<script type=\"application/ld+json\">\n{\n  \"@context\":\"https://schema.org\",\n  \"@type\":\"Article\",\n  \"headline\":\"Meta Ads Awareness UNLABEL: memilih creative yang lebih efisien lewat A/B test\",\n  \"description\":\"Analisis campaign awareness UNLABEL berdasarkan reach, impressions, CPM, CPR, creative, dan wilayah.\",\n  \"url\":\"https://nordy-sukmana.vercel.app/case-study/meta-ads-unlabel/\",\n  \"image\":\"https://nordy-sukmana.vercel.app/assets/thumbnails/meta-awareness-unlabel.webp\",\n  \"inLanguage\":\"id-ID\",\n  \"dateModified\":\"2026-08-15\",\n  \"author\":{\"@type\":\"Person\",\"name\":\"Nordy Sukmana\",\"url\":\"https://nordy-sukmana.vercel.app/\"},\n  \"publisher\":{\"@type\":\"Person\",\"name\":\"Nordy Sukmana\",\"url\":\"https://nordy-sukmana.vercel.app/\"},\n  \"mainEntityOfPage\":\"https://nordy-sukmana.vercel.app/case-study/meta-ads-unlabel/\"\n}\n</script>\n<link rel=\"icon\" href=\"../../assets/brand/nordy-mark.svg\" type=\"image/svg+xml\">\n<link rel=\"icon\" href=\"../../favicon.ico\" sizes=\"any\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"../../assets/case-study.css\">";
---
<BaseLayout head={head}>
  <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
  <CaseStudyHeader />
<main id="main-content">
  <section class="case-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="../../">Portfolio</a><span aria-hidden="true">/</span><span>Meta Ads UNLABEL</span></nav>
      <span class="case-badge">Meta Ads · Awareness · A/B Testing</span>
      <h1>Meta Ads Awareness UNLABEL: memilih creative yang lebih efisien lewat A/B test.</h1>
      <p class="case-lede">Objective awareness tidak tepat dinilai dengan ukuran penjualan atau biaya klik saja. Pada campaign ini, saya membandingkan dua pendekatan creative dengan targeting yang sama untuk melihat mana yang menghasilkan jangkauan dan tayangan secara lebih efisien.</p>
      <div class="meta-row"><span class="meta-chip">UNLABEL</span><span class="meta-chip">Facebook &amp; Instagram</span><span class="meta-chip">Regional targeting</span><span class="meta-chip">Looker Studio</span></div>
      <section class="metrics" aria-label="Ringkasan hasil campaign">
        <div class="metric"><span class="metric-label">Reach</span><strong>404.864</strong><small>Audiens unik yang dijangkau</small></div>
        <div class="metric"><span class="metric-label">Impressions</span><strong>414.396</strong><small>Dengan frekuensi yang tetap terkendali</small></div>
        <div class="metric"><span class="metric-label">Amount spent</span><strong>Rp599 rb</strong><small>Total biaya pada laporan</small></div>
        <div class="metric"><span class="metric-label">Average CPM</span><strong>Rp1.456</strong><small>Efisien untuk objective awareness</small></div>
      </section>
    </div>
  </section>

  <div class="shell content-wrap">
    <article class="article-card">
      <section class="story-section case-summary" aria-labelledby="case-summary-title">
        <span class="section-label">Ringkasan singkat</span>
        <h2 id="case-summary-title">Apa yang terjadi dan apa yang saya lakukan.</h2>
        <div class="case-summary-grid">
          <div class="case-summary-item"><h3>Masalah</h3><p>Dua jenis materi iklan terlihat sama sama menarik, tetapi belum jelas mana yang paling efisien untuk memperluas jangkauan.</p></div>
          <div class="case-summary-item"><h3>Keputusan saya</h3><p>Saya membandingkan kedua materi dengan target audiens yang sama, lalu melihat reach, impressions, CPM, dan hasil di setiap wilayah.</p></div>
          <div class="case-summary-item"><h3>Hasil</h3><p>Materi yang menampilkan produk bersama model memberi biaya tayang yang lebih rendah dan lebih konsisten di semua wilayah yang dibandingkan.</p></div>
          <div class="case-summary-item"><h3>Bukti</h3><p>Campaign menjangkau 404.864 orang dengan 414.396 impressions dan biaya Rp599 ribu. Data per wilayah menunjukkan materi produk dan model selalu memiliki CPM lebih rendah.</p></div>
          <div class="case-summary-item"><h3>Pelajaran</h3><p>Materi iklan sebaiknya dipilih berdasarkan tujuan campaign dan data yang relevan, bukan hanya berdasarkan selera atau jumlah klik.</p></div>
        </div>
      </section>

      <section class="story-section">
        <span class="section-label">01 · Konteks</span>
        <h2>Awareness membutuhkan cara membaca data yang berbeda.</h2>
        <p class="lead-paragraph">Tujuan campaign ini adalah memperluas eksposur UNLABEL di Facebook dan Instagram. Karena fokusnya bukan traffic, saya menempatkan reach, impressions, CPM, dan cost per result sebagai ukuran utama. CPC tetap saya pantau, tetapi tidak digunakan sendirian untuk menentukan keberhasilan campaign.</p>
        <p>Dengan biaya Rp599.420, campaign mencatat reach 404.864 dan 414.396 impressions. Dashboard juga menunjukkan average CPM Rp1.456,46 serta average CPC link click Rp2.875,23.</p>
        <figure class="evidence">
          <img src="../../assets/thumbnails/meta-awareness-unlabel.webp" alt="Dashboard Meta Ads Awareness UNLABEL berisi KPI reach, impressions, biaya, peta wilayah, dan perbandingan dua jenis creative" width="1200" height="750">
          <figcaption>Dashboard campaign UNLABEL yang membandingkan Products &amp; Model set dengan Products Only set pada targeting yang sama.</figcaption>
        </figure>
      </section>

      <section class="story-section">
        <span class="section-label">02 · Tantangan</span>
        <h2>Menentukan pemenang creative tanpa terjebak pada vanity metric.</h2>
        <p>Dua kelompok creative diuji: gambar produk bersama model dan materi product only berbentuk video. Keduanya menggunakan targeting yang sama. Tantangannya adalah memilih creative yang benar-benar efisien, bukan sekadar terlihat menarik atau menghasilkan klik lebih banyak.</p>
        <div class="insight-box"><strong>Konteks objective menentukan arti sebuah angka.</strong><p>CPC Rp2.875 terlihat tinggi bila dinilai sebagai campaign traffic. Namun pada campaign awareness, reach dan biaya untuk menghasilkan tayangan menjadi indikator yang lebih relevan.</p></div>
      </section>

      <section class="story-section">
        <span class="section-label">03 · Pendekatan</span>
        <h2>Saya membandingkan creative pada level wilayah.</h2>
        <ol class="process-list">
          <li><strong>Samakan konteks targeting</strong>Kedua creative dibaca pada audiens dan wilayah yang sama agar perbandingannya tetap adil.</li>
          <li><strong>Bandingkan reach dan impressions</strong>Saya melihat kemampuan masing-masing creative menghasilkan distribusi awareness, bukan hanya link click.</li>
          <li><strong>Gunakan CPM dan CPR sebagai penentu efisiensi</strong>Biaya yang lebih rendah untuk distribusi yang sebanding menjadi dasar pemilihan creative.</li>
          <li><strong>Periksa pola wilayah</strong>Hasil per region membantu melihat apakah kemenangan creative konsisten atau hanya ditopang satu area.</li>
        </ol>
      </section>

      <section class="story-section">
        <span class="section-label">04 · Temuan</span>
        <h2>Creative dengan produk dan model memberikan efisiensi yang lebih konsisten.</h2>
        <section class="table-scroll" aria-label="Perbandingan CPM creative UNLABEL" tabindex="0">
          <table class="comparison-table">
            <thead><tr><th>Wilayah</th><th>CPM Produk + Model</th><th>CPM Product Only</th><th>Lebih efisien</th></tr></thead>
            <tbody>
              <tr><td>Jawa Tengah</td><td class="best">Rp1.405,66</td><td>Rp1.482,09</td><td class="best">Produk + Model</td></tr>
              <tr><td>Jawa Barat</td><td class="best">Rp1.415,77</td><td>Rp1.504,78</td><td class="best">Produk + Model</td></tr>
              <tr><td>DI Yogyakarta</td><td class="best">Rp1.388,25</td><td>Rp1.507,08</td><td class="best">Produk + Model</td></tr>
              <tr><td>Banten</td><td class="best">Rp1.420,60</td><td>Rp1.511,67</td><td class="best">Produk + Model</td></tr>
              <tr><td>Jakarta</td><td class="best">Rp1.391,49</td><td>Rp1.537,18</td><td class="best">Produk + Model</td></tr>
            </tbody>
          </table>
        </section>
        <ul class="finding-list">
          <li><strong>Produk + model unggul secara konsisten.</strong>CPM-nya lebih rendah di seluruh wilayah yang dibandingkan dalam laporan.</li>
          <li><strong>Jawa Tengah menjadi pusat audiens paling potensial.</strong>Wilayah ini menyumbang sekitar 73,3% reach, disusul Jawa Barat sekitar 13%.</li>
          <li><strong>Creative winner tidak dipilih berdasarkan selera.</strong>Produk + model ditetapkan sebagai pemenang karena menghasilkan impressions yang lebih kuat dengan CPM dan CPR lebih rendah.</li>
          <li><strong>CTR 0,06 bukan satu-satunya dasar keputusan.</strong>Objective campaign adalah awareness, sehingga kualitas distribusi lebih penting daripada mengejar klik.</li>
        </ul>
      </section>

      <section class="story-section">
        <span class="section-label">05 · Keputusan</span>
        <h2>Menggunakan pemenang A/B test sebagai arah creative berikutnya.</h2>
        <ul class="recommend-list">
          <li><strong>Prioritaskan format produk dan model.</strong>Gunakan format pemenang sebagai baseline, kemudian kembangkan variasi pose, benefit produk, dan komposisi visual.</li>
          <li><strong>Pertahankan Jawa Tengah sebagai wilayah inti.</strong>Scaling dapat dimulai dari area dengan konsentrasi reach terbesar sambil tetap menguji potensi wilayah berikutnya.</li>
          <li><strong>Pisahkan evaluasi awareness dan traffic.</strong>Jika kebutuhan berikutnya adalah kunjungan, buat campaign dengan objective berbeda agar CPC dan CTR dapat dinilai dalam konteks yang tepat.</li>
          <li><strong>Lanjutkan pengujian satu variabel.</strong>Ubah satu elemen utama dalam setiap eksperimen agar penyebab peningkatan performa dapat dibaca lebih jelas.</li>
        </ul>
        <div class="insight-box"><strong>Pelajaran utama</strong><p>A/B test yang berguna bukan sekadar menunjukkan dua angka berbeda. Pengujian harus menghasilkan keputusan creative yang dapat dipakai pada campaign berikutnya.</p></div>
      </section>
    </article>

    <aside class="side-column" aria-label="Ringkasan case study">
      <section class="side-card"><h2>Peran saya</h2><ul><li><span>Campaign</span><strong>Awareness analysis</strong></li><li><span>Experiment</span><strong>Creative A/B test</strong></li><li><span>Output</span><strong>Creative direction</strong></li></ul></section>
      <section class="side-card"><h2>Stack</h2><ul><li><span>Media</span><strong>Meta Ads</strong></li><li><span>Reporting</span><strong>Looker Studio</strong></li><li><span>Dimension</span><strong>Creative · Region</strong></li></ul></section>
      <section class="side-card source-note"><span class="source-kicker">Cara membaca</span><p>Angka biaya dan rasio ditampilkan sesuai format dashboard sumber. Kesimpulan difokuskan pada objective awareness, bukan conversion.</p></section>
    </aside>
  </div>

  <section class="next-section">
    <div class="shell">
      <div class="next-head"><h2>Lanjut ke case study berikutnya.</h2><a href="../../#portfolio">Lihat seluruh portfolio →</a></div>
      <div class="next-grid">
        <a class="next-card" href="../shopee-cpas/"><span>CPAS · Marketplace</span><h3>Shopee Super Shopping Day 9.9</h3><p>ROAS 10,49× dengan analisis efisiensi harian saat traffic dan budget mulai di-scale.</p></a>
        <a class="next-card" href="../performance-analysis/"><span>Cross-channel</span><h3>Performance Ads Analysis</h3><p>Menyusun prioritas budget Meta, Google, dan TikTok Ads berdasarkan efisiensi channel.</p></a>
      </div>
    </div>
  </section>
</main>
  <SiteFooter caseStudy />
  <script is:inline src="/assets/analytics-loader.js"></script>
</BaseLayout>
