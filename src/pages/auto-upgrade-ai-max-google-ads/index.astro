const faqItems = [
  {
    question: 'Apakah Dynamic Search Ads ikut dimigrasikan sekarang?',
    answer: 'Tidak. Google menunda peningkatan otomatis Dynamic Search Ads hingga Februari 2027. Jadwal September 2026 tetap berlaku untuk Automatically Created Assets dan pengaturan broad match pada level campaign.'
  },
  {
    question: 'Apakah AI Max otomatis mengaktifkan Final URL Expansion?',
    answer: 'Tidak selalu. Migrasi dari Automatically Created Assets mengaktifkan Search Term Matching dan Text Customization, sedangkan migrasi dari broad match pada level campaign mengaktifkan Search Term Matching. Periksa panel pengaturan untuk memastikan status Final URL Expansion.'
  },
  {
    question: 'Apakah AI Max dapat dinonaktifkan?',
    answer: 'Ya. Google menyediakan pilihan untuk mematikan AI Max atau mengubah fitur di dalamnya. Namun, mematikannya tidak otomatis mengembalikan seluruh perilaku lama, terutama aturan prioritas keyword broad match.'
  },
  {
    question: 'Berapa lama performa sebaiknya dievaluasi?',
    answer: 'Google menyarankan menunggu setidaknya dua minggu setelah aktivasi. Sesuaikan periode evaluasi dengan jeda conversion dan volume data bisnis.'
  },
  {
    question: 'Apakah AI Max menjamin conversion bertambah?',
    answer: 'Tidak. Hasil dipengaruhi kualitas data, bidding, website, penawaran, persaingan, dan conversion tracking. Rata rata hasil platform tidak menjamin performa pada setiap akun.'
  }
];

