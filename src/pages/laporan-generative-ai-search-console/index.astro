const image = 'https://nordy-sukmana.vercel.app/assets/brand/open-graph.png';
const faqItems = [
  {
    question: 'Apakah semua website sudah mendapatkan laporan Generative AI?',
    answer: 'Belum. Google masih meluncurkannya secara bertahap ke sebagian website. Tidak munculnya laporan di akunmu belum membuktikan bahwa website sama sekali tidak memperoleh visibilitas dalam fitur AI.'
  },
  {
    question: 'Apakah impressions dari AI Search sama dengan traffic?',
    answer: 'Tidak. Impressions menunjukkan bahwa URL muncul dalam fitur generative AI. Traffic baru tercatat ketika pengguna benar-benar mengunjungi website.'
  },
  {
    question: 'Apakah GEO menggantikan SEO?',
    answer: 'Tidak. Untuk ekosistem Google, SEO tetap menjadi fondasi karena fitur generative AI memanfaatkan indeks, sistem ranking, dan kualitas pencarian yang sama. GEO atau AIO lebih tepat dipahami sebagai lapisan tambahan dalam strategi visibilitas.'
  },
  {
    question: 'Apakah perlu menambahkan schema khusus AI?',
    answer: 'Tidak ada schema khusus yang menjamin website muncul di AI Overview atau AI Mode. Gunakan structured data yang memang sesuai dengan isi halaman.'
  },
  {
    question: 'Mengapa impressions AI Search tiba-tiba turun pada Agustus 2026?',
    answer: 'Google mengonfirmasi adanya masalah pencatatan impressions pada 13–17 Agustus 2026. Penurunan pada periode tersebut dapat berasal dari gangguan pelaporan, bukan perubahan performa aktual.'
  }
